{
  "manifest_version": 3,
  "name": "TheOrangeFilter - Toggle Edition",
  "short_name": "OrangeToggle",
  "description": "A smart content filter with a reversible toggle: Lock Her Up filters out political content, Lock Him Up shows ONLY political content.",
  "version": "1.0.0",
  "homepage_url": "https://bjorn12341234.github.io/adblocker/",
  "permissions": [
    "storage",
    "offscreen",
    "declarativeNetRequest",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "The Orange Filter Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
