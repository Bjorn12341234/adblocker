{
  "manifest_version": 3,
  "name": "The Orange Filter",
  "short_name": "Orange Filter",
  "description": "The Orange Filter - a customizable content filter that hides topics and keywords you choose from your browsing feed.",
  "version": "1.0.1",
  "permissions": ["storage", "offscreen", "declarativeNetRequest", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "The Orange Filter Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
